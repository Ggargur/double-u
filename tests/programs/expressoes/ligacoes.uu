// documentação de topo
/// Soma com var.
fn soma(n: int) -> int =
    var total = 0    // acumulador
    var i = 1
    while i <= n
        total = total + i
        i = i + 1
    total

fn +main() -> Pending(int) io =
    x =
        a = 20
        b = 5
        a + b
    for _ <- print("{x}")
        _ <- print("{soma(2)}")
        yield 0
