//> -128
//> 0
//> 255
//> 65535
//> -2147483648
//> 9223372036854775807
fn +main() -> Pending(int) io =
    a: i8 = 127
    b: u8 = 255
    c: u8 = 0
    d: u16 = 0
    e: i32 = 2147483647
    f: i64 = -9223372036854775807
    for _ <- print("{a + 1}")
        _ <- print("{b + 1}")
        _ <- print("{c - 1}")
        _ <- print("{d - 1}")
        _ <- print("{e + 1}")
        _ <- print("{f - 2}")
        yield 0
