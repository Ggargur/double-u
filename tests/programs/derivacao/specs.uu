//> 3.14
//> [   42]
//> [42   ]
//> [ 42  ]
//> [00042]
//> [***ab]
//> 2.500
//> ff
fn +main() -> Pending(int) io =
    pi = 3.14159
    hp = 42
    for _ <- print("{pi:.2f}")
        _ <- print("[{hp:>5}]")
        _ <- print("[{hp:<5}]")
        _ <- print("[{hp:^5}]")
        _ <- print("[{hp:05}]")
        _ <- print("[{"ab":*>5}]")
        _ <- print("{2.5:.3f}")
        _ <- print("{255:x}")
        yield 0
