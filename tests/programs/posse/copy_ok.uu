//> 3 3
//> 1.0
fn guarda(own xs: List(int)) -> int = len(xs)
type +Vec = { +x: float  +y: float }
fn consome(own v: Vec) -> float = v.x
fn +main() -> Pending(int) io =
    xs = [1 2 3]
    n = guarda(xs.copy)
    k = len(xs)
    v = Vec(1.0 2.0)
    a = consome(v)
    for _ <- print("{n} {k}")
        _ <- print("{v.x}")
        yield 0
