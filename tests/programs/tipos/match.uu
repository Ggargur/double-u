//> crítico
//> acerto de 5
//> errou
//> área 12.0
//> círculo grande
//> zero
//> outro
type +Evento = Hit(int) | Miss
type +Shape = Circle(radius: float) | Rect(w: float h: float)
type +Caixa = Vazia | Cheia(Shape)
fn msg(e: Evento) -> Text = match e
    Hit(n) if n > 10 -> "crítico"
    Hit(n)           -> "acerto de {n}"
    Miss             -> "errou"
fn area(s: Shape) -> float = match s
    Circle(r) -> 3.0 * r * r
    Rect(w h) -> w * h
fn desc(c: Caixa) -> Text = match c
    Cheia(Circle(r)) if r > 5.0 -> "círculo grande"
    Cheia(Circle(_)) -> "círculo"
    Cheia(Rect(_ _)) -> "retângulo"
    Vazia -> "vazia"
fn lit(n: int) -> Text = match n
    0 -> "zero"
    _ -> "outro"
fn +main() -> Pending(int) io =
    for _ <- print(msg(Hit(20)))
        _ <- print(msg(Hit(5)))
        _ <- print(msg(Miss))
        _ <- print("área {area(Rect(3.0 4.0))}")
        _ <- print(desc(Cheia(Circle(radius: 6.0))))
        _ <- print(lit(0))
        _ <- print(lit(3))
        yield 0
