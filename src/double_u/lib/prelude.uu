// Prelude da double-u: tipos e traits disponíveis sem import.

type +Maybe(T) = Just(T) | Nothing
type +Result(T E) = Ok(T) | Err(E)
type +Either(A B) = Left(A) | Right(B)

/// Spec de formatação já parseado: `{x:>5}`, `{x:.2f}`.
type +Spec = { +fill: int  +align: int  +width: int  +precision: int  +kind: int }

trait +Add(T) =
    fn +(a: T) + (b: T) -> T infixl 6
trait +Sub(T) =
    fn +(a: T) - (b: T) -> T infixl 6
trait +Mul(T) =
    fn +(a: T) * (b: T) -> T infixl 7
trait +Div(T) =
    fn +(a: T) / (b: T) -> T infixl 7
trait +Rem(T) =
    fn +(a: T) % (b: T) -> T infixl 7
trait +Pow(T) =
    fn +(a: T) ** (b: T) -> T infixr 8
trait +Eq(T) =
    fn +(a: T) == (b: T) -> bool infix 4
    fn +(a: T) != (b: T) -> bool infix 4 = not((a == b))
trait +Ord(T) =
    fn +(a: T) < (b: T) -> bool infix 4
    fn +(a: T) <= (b: T) -> bool infix 4 = not((b < a))
    fn +(a: T) > (b: T) -> bool infix 4 = b < a
    fn +(a: T) >= (b: T) -> bool infix 4 = not((a < b))
trait +Num(T) given Add(T) Sub(T) Mul(T) =
    fn +fromInt(x: int) -> T
trait +Append(T) =
    fn +(a: T) ++ (b: T) -> T infixr 5
trait +Format(T) =
    fn +format(x: T spec: Spec) -> Text
trait +Clone(T) =
    fn +(x: T).copy -> T

trait +Functor(F) =
    fn +map(x: F(A) f: A -> B) -> F(B)
trait +Monad(M) =
    fn +pure(own x: A) -> M(A)
    fn +(m: M(A)) >>= (f: A -> M(B)) -> M(B) infixl 1
trait +Filter(F) =
    fn +filter(x: F(A) f: A -> bool) -> F(A)
trait +Each(S) =
    fn +each(s: S(A) f: A -> ()) -> ()
trait +Try(M) =
    fn +branch(m: M(A)) -> Either(A M(A))

fn +not(b: bool) -> bool = if b then false else true

fn +panic(msg: Text) -> T = @prim("panic")

// ---------------------------------------------------------------- Maybe
impl Functor(Maybe) =
    fn map(m f) = match m
        Just(x) -> Just(f(x))
        Nothing -> Nothing
impl Monad(Maybe) =
    fn pure(x) = Just(x)
    fn (m) >>= (f) = match m
        Just(x) -> f(x)
        Nothing -> Nothing
impl Filter(Maybe) =
    fn filter(m f) = match m
        Just(x) -> if f(x) then Just(x) else Nothing
        Nothing -> Nothing
impl Try(Maybe) =
    fn branch(m) = match m
        Just(x) -> Left(x)
        Nothing -> Right(Nothing)

// ---------------------------------------------------------------- Result
impl Functor(Result) =
    fn map(r f) = match r
        Ok(x) -> Ok(f(x))
        Err(e) -> Err(e)
impl Monad(Result) =
    fn pure(x) = Ok(x)
    fn (m) >>= (f) = match m
        Ok(x) -> f(x)
        Err(e) -> Err(e)
impl Try(Result) =
    fn branch(r) = match r
        Ok(x) -> Left(x)
        Err(e) -> Right(Err(e))

// ---------------------------------------------------------------- Pending e IO
impl Functor(Pending) =
    fn map(p f) = @prim("pending_map")
impl Monad(Pending) =
    fn pure(x) = @prim("pending_pure")
    fn (m) >>= (f) = @prim("pending_bind")
impl Clone(Pending(T)) =
    fn (x).copy = x

/// Resultado já disponível? Puro: só olha o estado.
fn +(p: Pending(T)).poll -> Maybe(T) = @prim("pending_poll")

/// Imprime uma linha no fim do tick (thread principal, em ordem).
fn +print(t: Text) -> Pending(()) io = @prim("req_print")
/// Resolve no fim do tick atual.
fn +nextTick() -> Pending(()) io = @prim("req_next_tick")
/// Resolve depois de `n` ticks.
fn +sleepTicks(n: int) -> Pending(()) io =
    if n <= 0 then pure(()) else nextTick() >>= (u => sleepTicks((n - 1)))
/// Espera `ms` milissegundos num worker, sem bloquear o tick.
fn +sleepMs(ms: int) -> Pending(()) io = @prim("req_sleep_ms")
/// Lê o arquivo inteiro num worker.
fn +readFile(path: Text) -> Pending(Result(Text Text)) io = @prim("req_read_file")
/// Escreve (substitui) o arquivo num worker.
fn +writeFile(path: Text content: Text) -> Pending(Result(() Text)) io = @prim("req_write_file")

// ---------------------------------------------------------------- Text
impl Append(Text) =
    fn (a) ++ (b) = @prim("text_concat")
impl Eq(Text) =
    fn (a) == (b) = @prim("text_eq")
impl Format(Text) =
    fn format(x spec) = @prim("fmt_text")
impl Format(bool) =
    fn format(x spec) = if x then "true" else "false"
impl Format(()) =
    fn format(x spec) = "()"
impl Eq(bool) =
    fn (a) == (b) = @prim("op_eq")
impl Eq(()) =
    fn (a) == (b) = true
impl Clone(Text) =
    fn (x).copy = x

// ---------------------------------------------------------------- List
fn +len(xs: List(T)) -> int = @prim("list_len")
fn +get(xs: List(T) i: int) -> Maybe(T) = @prim("list_get")
fn +at(xs: List(T) i: int) -> T = @prim("list_at")
fn +push(own xs: List(T) own x: T) -> List(T) = @prim("list_push")
fn +set(own xs: List(T) i: int own x: T) -> List(T) = @prim("list_set")
fn +fold(xs: List(T) init: A f: (A T) -> A) -> A = @prim("list_fold")
fn +range(a: int b: int) -> List(int) = @prim("list_range")
fn +(t: Text).length -> int = @prim("text_len")

impl Append(List(T)) =
    fn (a) ++ (b) = @prim("list_concat")
impl Functor(List) =
    fn map(xs f) = @prim("list_map")
impl Monad(List) =
    fn pure(x) = @prim("list_pure")
    fn (m) >>= (f) = @prim("list_bind")
impl Filter(List) =
    fn filter(xs f) = @prim("list_filter")
impl Each(List) =
    fn each(xs f) = @prim("list_each")
impl Format(List(T)) given Format(T) =
    fn format(xs spec) = fmtText(("[" ++ juntaFmt(xs 0 "") ++ "]") spec)
impl Eq(List(T)) given Eq(T) =
    fn (a) == (b) = len(a) == len(b) && listaIgual(a b 0)
impl Clone(List(T)) =
    fn (x).copy = x

fn juntaFmt(xs: List(T) i: int acc: Text) -> Text given Format(T) =
    if i >= len(xs) then acc
    else if i == 0 then juntaFmt(xs (i + 1) "{at(xs i)}")
    else juntaFmt(xs (i + 1) (acc ++ " {at(xs i)}"))

fn listaIgual(a: List(T) b: List(T) i: int) -> bool given Eq(T) =
    if i >= len(a) then true
    else if at(a i) == at(b i) then listaIgual(a b (i + 1))
    else false

fn fmtText(t: Text spec: Spec) -> Text = @prim("fmt_text")

// ---------------------------------------------------------------- Map (lista de associação)
type +Map(K V) = { entries: List(#(K V)) }

fn +lookup(k: K m: Map(K V)) -> Maybe(V) given Eq(K) = buscaEm(m.entries k 0)
fn buscaEm(es: List(#(K V)) k: K i: int) -> Maybe(V) given Eq(K) =
    if i >= len(es) then Nothing
    else match at(es i)
        #(k2 v) -> if k2 == k then Just(v) else buscaEm(es k (i + 1))
fn +insert(own m: Map(K V) own k: K own v: V) -> Map(K V) given Eq(K) =
    Map(push(semChave(m.entries k 0 []) #(k v)))
fn semChave(es: List(#(K V)) k: K i: int own acc: List(#(K V))) -> List(#(K V)) given Eq(K) =
    if i >= len(es) then acc
    else match at(es i)
        #(k2 v) -> if k2 == k then semChave(es k (i + 1) acc) else semChave(es k (i + 1) push(acc #(k2 v)))
fn +size(m: Map(K V)) -> int = len(m.entries)
impl Format(Map(K V)) given Format(K) Format(V) =
    fn format(m spec) = fmtText(("{{" ++ fmtPares(m.entries 0 "") ++ "}") spec)
fn fmtPares(es: List(#(K V)) i: int acc: Text) -> Text given Format(K) Format(V) =
    if i >= len(es) then acc
    else match at(es i)
        #(k v) -> fmtPares(es (i + 1) (if i == 0 then "{k}: {v}" else acc ++ "  {k}: {v}"))

trait +EachMut(S) =
    fn +eachMut(mut s: S(A) f: A -> ()) -> ()
impl EachMut(List) =
    fn eachMut(xs f) = @prim("list_each_mut")
